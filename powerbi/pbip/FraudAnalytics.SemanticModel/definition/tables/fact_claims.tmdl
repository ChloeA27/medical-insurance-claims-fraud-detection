table fact_claims
	lineageTag: adcf522c-7514-4d75-8645-f30e2559bcc2

	measure 'Total Claims' = COUNTROWS ( fact_claims )
		formatString: #,##0
		displayFolder: Core
		lineageTag: 1ff8ab8d-ff40-4a13-94f0-3f59d3c9d237

	measure 'Total Claim Amount $' = SUM ( fact_claims[claim_amount] )
		formatString: $#,##0
		displayFolder: Core
		lineageTag: b678f886-c442-4659-8afc-152c30a39364

	measure 'Avg Claim Amount' = AVERAGE ( fact_claims[claim_amount] )
		formatString: $#,##0
		displayFolder: Core
		lineageTag: 0396b828-5be6-4604-b2a3-4f3e0e72d1d7

	measure 'Inpatient Share %' = DIVIDE ( CALCULATE ( [Total Claims], fact_claims[claim_type] = "Inpatient" ), [Total Claims] )
		formatString: 0.0%
		displayFolder: Core
		lineageTag: 2fecd8ee-892e-40ea-9297-08a92f699cce

	measure 'Fraud Claim Count' = CALCULATE ( [Total Claims], fact_claims[is_fraudulent] = TRUE () )
		formatString: #,##0
		displayFolder: Fraud Exposure
		lineageTag: d2cf6c05-accc-428e-bb34-9b78b43b83b5

	measure 'Fraud Rate %' = DIVIDE ( [Fraud Claim Count], [Total Claims] )
		formatString: 0.0%
		displayFolder: Fraud Exposure
		lineageTag: a5949963-7e13-46fd-89e7-d9e3e3103146

	measure 'Total Fraud Exposure $' = CALCULATE ( [Total Claim Amount $], fact_claims[is_fraudulent] = TRUE () )
		formatString: $#,##0
		displayFolder: Fraud Exposure
		lineageTag: 4a56dbc0-e42b-4cfa-b44a-be0f8b531e4e

	measure 'Fraud Exposure % of Total $' = DIVIDE ( [Total Fraud Exposure $], [Total Claim Amount $] )
		formatString: 0.0%
		displayFolder: Fraud Exposure
		lineageTag: a4ad2771-a1a9-487c-9e8d-dc2ea90d50d4

	measure 'Fraud Rate Lift (x)' = VAR Baseline = CALCULATE ( [Fraud Rate %], REMOVEFILTERS ( dim_diagnosis ), REMOVEFILTERS ( dim_procedure ) ) RETURN DIVIDE ( [Fraud Rate %], Baseline )
		formatString: 0.00
		displayFolder: Fraud Exposure
		lineageTag: 43f16db5-be05-40d3-965c-d4d31d346d36

	measure 'Distinct Fraudulent Providers' = CALCULATE ( DISTINCTCOUNT ( fact_claims[provider_sk] ), fact_claims[is_fraudulent] = TRUE () )
		formatString: #,##0
		displayFolder: Provider Risk
		lineageTag: 146427a3-e6f2-405f-9592-79beba2c9e47

	measure 'Fraud Exposure per Fraudulent Provider $' = DIVIDE ( [Total Fraud Exposure $], [Distinct Fraudulent Providers] )
		formatString: $#,##0
		displayFolder: Provider Risk
		lineageTag: f2f8701e-ff54-450e-940c-63879438d752

	measure 'Top 50 Provider Fraud Share %' = VAR ProviderFraud = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( fact_claims[provider_sk] ), fact_claims[is_fraudulent] = TRUE () ), "@FraudAmt", [Total Fraud Exposure $] ) VAR Top50Total = SUMX ( TOPN ( 50, ProviderFraud, [@FraudAmt], DESC ), [@FraudAmt] ) RETURN DIVIDE ( Top50Total, SUMX ( ProviderFraud, [@FraudAmt] ) )
		formatString: 0.0%
		displayFolder: Provider Risk
		lineageTag: fe267586-0a3c-4040-b032-471fa562b28e

		changedProperty = IsHidden

	measure 'Claim Amount Prior Month $' = CALCULATE ( [Total Claim Amount $], DATEADD ( dim_date[full_date], -1, MONTH ) )
		formatString: $#,##0
		displayFolder: Trend
		lineageTag: 1caf903e-ed25-401b-b9fb-93c964d5502c

	measure 'Claim Amount MoM %' = DIVIDE ( [Total Claim Amount $] - [Claim Amount Prior Month $], [Claim Amount Prior Month $] )
		formatString: 0.0%
		displayFolder: Trend
		lineageTag: 8807464b-7402-49bb-b727-c3c071d6028d

	measure 'Claim Count QoQ %' = VAR PriorQ = CALCULATE ( [Total Claims], DATEADD ( dim_date[full_date], -1, QUARTER ) ) RETURN DIVIDE ( [Total Claims] - PriorQ, PriorQ )
		formatString: 0.0%
		displayFolder: Trend
		lineageTag: f97f05da-8175-4770-8d02-bd46700d22f1

